{
  "name": "dsh-repo-map",
  "version": "0.1.0",
  "description": "Regex-based compact repository map of source files and top-level symbols for DeepSeek Harness. No LSP, no call graph.",
  "type": "module",
  "bin": { "dsh-repo-map": "bin/dsh-repo-map.mjs" },
  "exports": { ".": "./plugin/index.js", "./map": "./src/map.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "repo", "map", "symbols", "context"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-repo-map" }
}
